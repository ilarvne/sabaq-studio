# Optional absolute paths for a packaged installation. The default database is .data/studio.sqlite.
# STUDIO_DB_PATH=
# STUDIO_STATIC_ROOT=
# STUDIO_CATALOG_ROOT=

# Optional Alem Plus services. Each key is scoped to the service listed.
ALEM_API_KEY=
# Allow teachers to opt in per assistant message to sending matched source excerpts to Alem.
STUDIO_CLOUD_SOURCE_RAG=0
ALEM_EMBEDDINGS_API_KEY=
ALEM_RERANK_API_KEY=
ALEM_STT_KK_API_KEY=
ALEM_STT_API_KEY=
ALEM_OCR_API_KEY=
# In gateway mode, list exact HTTPS origins only after confirming Kazakhstan processing and storage.
# Numeric loopback workers are permitted. The separate public-search exception uses STUDIO_RESEARCH_PROVIDER.
STUDIO_KZ_PROVIDER_ORIGINS=

# Optional TypeSafe Jev verifier. eval:jev sends only its fixed public examples to api.typesafe.ai.
# Use --dry-run to inspect them without credentials or HTTP calls. Pin the model for repeatable comparisons.
TYPESAFE_API_KEY=
STUDIO_JEV_MODEL=
# Runtime claim verification requires an explicit KZ deployment endpoint and its approved HTTPS origin above.
# Set the full /v1/systemone endpoint and STUDIO_JEV_REGION=KZ after the operator confirms residency.
STUDIO_JEV_ENDPOINT=
STUDIO_JEV_REGION=
# Minimum support probability for the runtime claim check.
STUDIO_JEV_MIN_SUPPORT=0.9

# Optional approved image worker. Supply the full POST URL and its model, if required.
STUDIO_IMAGE_ENDPOINT=
STUDIO_IMAGE_MODEL=
STUDIO_IMAGE_API_KEY=
# Direct OpenAI image generation is available in local mode for preview data.
OPENAI_API_KEY=
# Local installed Ollama vision model, required in gateway mode for generated illustrations.
STUDIO_IMAGE_VERIFY_MODEL=

# Optional local assistant for private lessons and saved preferences. Memory is sent only here.
STUDIO_OLLAMA_URL=http://127.0.0.1:11434
STUDIO_ASSISTANT_OLLAMA_MODEL=
# Optional local translator. Defaults to the configured assistant chat model.
STUDIO_TRANSLATION_OLLAMA_MODEL=
STUDIO_MEM0_URL=

# Loopback Ollama embedding model. Use an installed multilingual model for KK/RU evaluation.
STUDIO_EMBEDDING_URL=
STUDIO_EMBEDDING_MODEL=

# Enable public research explicitly with searxng or exa. EXA_API_KEY is server-side.
STUDIO_RESEARCH_PROVIDER=
STUDIO_SEARCH_URL=
EXA_API_KEY=
# Optional approved search terms separated by |. Defaults include EN, KK and RU examples.
STUDIO_RESEARCH_TOPICS=

# Installed loopback classroom classifier. Required for NODE_ENV=production with STUDIO_AUTH_MODE=gateway.
STUDIO_MODERATION_OLLAMA_MODEL=

# A trusted identity gateway authenticates users before forwarding to the API.
STUDIO_AUTH_MODE=local
STUDIO_GATEWAY_SECRET=
# Optional same-origin shared text editing; requires gateway authentication.
STUDIO_COEDIT=0

# The gateway sets x-studio-gateway, x-studio-user, x-studio-org and optional x-studio-role.
# Never forward client-supplied identity headers. Keep the service on a private interface.

# Server-side ElevenLabs voice for preview and narrated video. Never expose the key to the browser.
ELEVENLABS_API_KEY=
STUDIO_ELEVENLABS_VOICE_ID=

# Background video. Use KZ with the regional allowlist, or global with the video-provider allowlist.
STUDIO_VIDEO_REGION=
STUDIO_VIDEO_PROVIDER_ORIGINS=
STUDIO_VIDEO_WORKER_URL=
STUDIO_VIDEO_PIPELINE_VERSION=
STUDIO_VIDEO_WORKER_KEY=
# Optional loopback worker using ElevenLabs narration and FFmpeg.
STUDIO_VIDEO_LOCAL_WORKER=0
STUDIO_VIDEO_WORKER_PORT=9700
STUDIO_VIDEO_WORKER_STORAGE=
STUDIO_VIDEO_MARK_EMBEDDER=
STUDIO_VIDEO_SIGNING_MANIFEST=
# Single-user avatar only. Gateway installations use the subject-scoped vault.
STUDIO_VIDEO_AVATAR_ID=
STUDIO_BIOMETRIC_VAULT_URL=
STUDIO_BIOMETRIC_VAULT_KEY=
STUDIO_BIOMETRIC_CONSENT_VERSION=
STUDIO_VIDEO_C2PA_ANCHORS=
STUDIO_VIDEO_C2PATOOL=
STUDIO_VIDEO_MARK_VERIFIER=
# Optional JSON array of calibrated voices for outline duration estimates.
# A profile has language, voice and wordsPerMinute. A subject profile also needs org.
# STUDIO_NARRATION_PROFILES=[{"language":"kk","voice":"classroom-kk","wordsPerMinute":118}]

STUDIO_AUTHORING_MODEL=
